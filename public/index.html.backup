<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Entity Relationship Visualization</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }
    
    .header {
      padding: 10px 20px;
      background-color: #f0f0f0;
      border-bottom: 1px solid #ddd;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    
    .controls {
      display: flex;
      gap: 10px;
      align-items: center;
    }
    
    .main-container {
      display: flex;
      flex: 1;
      overflow: hidden;
    }
    
    #graph-container {
      flex: 1;
      position: relative;
      overflow: hidden;
    }
    
    #details-panel {
      width: 300px;
      background-color: #f8f8f8;
      border-left: 1px solid #ddd;
      padding: 10px;
      overflow-y: auto;
      display: none;
    }
    
    #tooltip {
      position: absolute;
      padding: 8px;
      background-color: rgba(255, 255, 255, 0.9);
      border: 1px solid #ddd;
      border-radius: 4px;
      pointer-events: none;
      font-size: 12px;
      max-width: 200px;
      z-index: 1000;
      display: none;
    }
    
    .node {
      cursor: pointer;
    }
    
    .link {
      stroke-opacity: 0.6;
    }
    
    .property-link {
      stroke-dasharray: 5, 5;
    }
    
    .node text {
      font-size: 10px;
      pointer-events: none;
    }
    
    .node-property {
      fill: #4caf50;
    }
    
    .node-object {
      fill: #2196f3;
    }
    
    .node-array {
      fill: #9c27b0;
    }
    
    .node-text {
      fill: #ff9800;
    }
    
    .node-integer {
      fill: #f44336;
    }
    
    .node-boolean {
      fill: #795548;
    }
    
    .node-real {
      fill: #607d8b;
    }
    
    .details-title {
      font-size: 16px;
      font-weight: bold;
      margin-bottom: 10px;
      padding-bottom: 5px;
      border-bottom: 1px solid #ddd;
    }
    
    .details-section {
      margin-bottom: 15px;
    }
    
    .details-label {
      font-weight: bold;
      margin-bottom: 5px;
    }
    
    .details-value {
      word-break: break-word;
      margin-bottom: 10px;
    }
    
    .details-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 5px;
    }
    
    .details-table th, .details-table td {
      border: 1px solid #ddd;
      padding: 4px 8px;
      font-size: 12px;
      text-align: left;
    }
    
    .details-table th {
      background-color: #f0f0f0;
    }
    
    button {
      padding: 5px 10px;
      background-color: #4CAF50;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }
    
    button:hover {
      background-color: #45a049;
    }
    
    select {
      padding: 5px;
      border-radius: 4px;
      border: 1px solid #ddd;
    }
    
    .loading {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 18px;
      background-color: rgba(255, 255, 255, 0.8);
      padding: 20px;
      border-radius: 5px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
    
    .legend {
      position: absolute;
      bottom: 20px;
      left: 20px;
      background-color: rgba(255, 255, 255, 0.9);
      padding: 10px;
      border-radius: 5px;
      border: 1px solid #ddd;
      font-size: 12px;
    }
    
    .legend-item {
      display: flex;
      align-items: center;
      margin-bottom: 5px;
    }
    
    .legend-color {
      width: 15px;
      height: 15px;
      margin-right: 5px;
      border-radius: 2px;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>Entity Relationship Visualization</h1>
    <div class="controls">
      <select id="source-selector">
        <option value="">All Sources (Limited)</option>
      </select>
      <button id="reset-zoom">Reset View</button>
      <button id="toggle-details">Show Details</button>
    </div>
  </div>
  
  <div class="main-container">
    <div id="graph-container">
      <div id="tooltip"></div>
      <div class="loading">Loading data...</div>
      <div class="legend">
        <div class="legend-item">
          <div class="legend-color" style="background-color: #2196f3;"></div>
          <span>Object</span>
        </div>
        <div class="legend-item">
          <div class="legend-color" style="background-color: #9c27b0;"></div>
          <span>Array</span>
        </div>
        <div class="legend-item">
          <div class="legend-color" style="background-color: #ff9800;"></div>
          <span>Text</span>
        </div>
        <div class="legend-item">
          <div class="legend-color" style="background-color: #f44336;"></div>
          <span>Integer</span>
        </div>
        <div class="legend-item">
          <div class="legend-color" style="background-color: #795548;"></div>
          <span>Boolean</span>
        </div>
        <div class="legend-item">
          <div class="legend-color" style="background-color: #607d8b;"></div>
          <span>Real</span>
        </div>
      </div>
    </div>
    <div id="details-panel">
      <div class="details-title">Node Details</div>
      <div id="details-content"></div>
    </div>
  </div>
  
  <script src="https://d3js.org/d3.v7.min.js"></script>
  <script>
    // Main visualization code
    document.addEventListener('DOMContentLoaded', function() {
      const graphContainer = document.getElementById('graph-container');
      const detailsPanel = document.getElementById('details-panel');
      const tooltip = document.getElementById('tooltip');
      const sourceSelector = document.getElementById('source-selector');
      const resetZoomButton = document.getElementById('reset-zoom');
      const toggleDetailsButton = document.getElementById('toggle-details');
      const detailsContent = document.getElementById('details-content');
      
      // SVG dimensions
      let width = graphContainer.clientWidth;
      let height = graphContainer.clientHeight;
      
      // Create SVG container
      const svg = d3.select('#graph-container')
        .append('svg')
        .attr('width', width)
        .attr('height', height);
      
      // Create a group for the graph
      const g = svg.append('g');
      
      // Create zoom behavior
      const zoom = d3.zoom()
        .scaleExtent([0.1, 8])
        .on('zoom', (event) => {
          g.attr('transform', event.transform);
        });
      
      // Apply zoom to SVG
      svg.call(zoom);
      
      // Initialize the simulation
      let simulation = d3.forceSimulation()
        .force('link', d3.forceLink().id(d => d.id).distance(100))
        .force('charge', d3.forceManyBody().strength(-300))
        .force('center', d3.forceCenter(width / 2, height / 2))
        .force('collision', d3.forceCollide().radius(30));
      
      // Event listeners
      resetZoomButton.addEventListener('click', resetZoom);
      toggleDetailsButton.addEventListener('click', toggleDetails);
      sourceSelector.addEventListener('change', loadDataForSource);
      window.addEventListener('resize', handleResize);
      
      // Load initial data and source list
      fetchSourcesList();
      
      // Functions
      function fetchSourcesList() {
        fetch('/api/graph')
          .then(response => response.json())
          .then(data => {
            // Populate source selector
            data.sourceFiles.forEach(source => {
              const option = document.createElement('option');
              option.value = source;
              option.textContent = source;
              sourceSelector.appendChild(option);
            });
            
            // Initial graph rendering
            renderGraph(data.nodes, data.links);
            document.querySelector('.loading').style.display = 'none';
          })
          .catch(error => {
            console.error('Error fetching data:', error);
            document.querySelector('.loading').textContent = 'Error loading data';
          });
      }
      
      function loadDataForSource() {
        const selectedSource = sourceSelector.value;
        document.querySelector('.loading').style.display = 'block';
        
        fetch(`/api/graph/${selectedSource}`)
          .then(response => response.json())
          .then(data => {
            renderGraph(data.nodes, data.links);
            document.querySelector('.loading').style.display = 'none';
          })
          .catch(error => {
            console.error('Error fetching data:', error);
            document.querySelector('.loading').textContent = 'Error loading data';
          });
      }
      
      function renderGraph(nodes, links) {
        // Stop previous simulation
        simulation.stop();
        
        // Clear previous graph
        g.selectAll('*').remove();
        
        // Process links to create visual representation of property relationships
        const graphLinks = [];
        
        links.forEach(link => {
          // Direct link from source to target
          graphLinks.push({
            source: link.source,
            target: link.target,
            type: link.type,
            id: link.id,
            propertyId: link.property
          });
        });
        
        // Create links
        const link = g.append('g')
          .attr('class', 'links')
          .selectAll('line')
          .data(graphLinks)
          .enter()
          .append('line')
          .attr('class', d => `link ${d.type === 'ARRAY_ELEMENT' ? 'property-link' : ''}`)
          .attr('stroke', '#999')
          .attr('stroke-width', 1);
        
        // Create nodes
        const node = g.append('g')
          .attr('class', 'nodes')
          .selectAll('g')
          .data(nodes)
          .enter()
          .append('g')
          .attr('class', 'node')
          .call(d3.drag()
            .on('start', dragstarted)
            .on('drag', dragged)
            .on('end', dragended));
        
        // Add circles to nodes
        node.append('circle')
          .attr('r', d => getNodeRadius(d))
          .attr('class', d => `node-${d.type.toLowerCase()}`)
          .on('mouseover', showTooltip)
          .on('mouseout', hideTooltip)
          .on('click', showNodeDetails);
        
        // Add text labels to nodes
        node.append('text')
          .attr('dx', 12)
          .attr('dy', '.35em')
          .text(d => d.label);
        
        // Update simulation
        simulation = d3.forceSimulation(nodes)
          .force('link', d3.forceLink(graphLinks).id(d => d.id).distance(100))
          .force('charge', d3.forceManyBody().strength(-300))
          .force('center', d3.forceCenter(width / 2, height / 2))
          .force('collision', d3.forceCollide().radius(30))
          .on('tick', ticked);
        
        function ticked() {
          link
            .attr('x1', d => d.source.x)
            .attr('y1', d => d.source.y)
            .attr('x2', d => d.target.x)
            .attr('y2', d => d.target.y);
          
          node.attr('transform', d => `translate(${d.x},${d.y})`);
        }
      }
      
      function getNodeRadius(node) {
        switch (node.type) {
          case 'OBJECT':
            return 15;
          case 'ARRAY':
            return 12;
          default:
            return 8;
        }
      }
      
      function showTooltip(event, d) {
        tooltip.style.display = 'block';
        tooltip.innerHTML = `
          <strong>ID:</strong> ${d.id}<br>
          <strong>Type:</strong> ${d.type}<br>
          <strong>Value:</strong> ${d.fullLabel}
        `;
        
        const tooltipWidth = tooltip.offsetWidth;
        const tooltipHeight = tooltip.offsetHeight;
        
        tooltip.style.left = `${event.pageX - tooltipWidth / 2}px`;
        tooltip.style.top = `${event.pageY - tooltipHeight - 10}px`;
      }
      
      function hideTooltip() {
        tooltip.style.display = 'none';
      }
      
      function showNodeDetails(event, d) {
        // Show the details panel
        detailsPanel.style.display = 'block';
        toggleDetailsButton.textContent = 'Hide Details';
        
        // Show loading message
        detailsContent.innerHTML = 'Loading details...';
        
        // Fetch node details
        fetch(`/api/node/${d.id}`)
          .then(response => response.json())
          .then(data => {
            // Format details
            let html = `
              <div class="details-section">
                <div class="details-label">ID:</div>
                <div class="details-value">${data.id}</div>
                
                <div class="details-label">Type:</div>
                <div class="details-value">${data.type}</div>
                
                <div class="details-label">Value:</div>
                <div class="details-value">${data.value !== null ? data.value : 'N/A'}</div>
                
                <div class="details-label">Source File:</div>
                <div class="details-value">${data.sourceFile || 'N/A'}</div>
              </div>
            `;
            
            // Add relationships section
            if (data.relationships && data.relationships.length > 0) {
              html += `
                <div class="details-section">
                  <div class="details-label">Relationships:</div>
                  <table class="details-table">
                    <thead>
                      <tr>
                        <th>Type</th>
                        <th>Source</th>
                        <th>Property</th>
                        <th>Target</th>
                      </tr>
                    </thead>
                    <tbody>
              `;
              
              data.relationships.forEach(rel => {
                html += `
                  <tr>
                    <td>${rel.RELATIONSHIP_TYPE}</td>
                    <td>${rel.SOURCE_TEXT || rel.SOURCE_ID}</td>
                    <td>${rel.PROPERTY_TEXT || rel.PROPERTY_ID}</td>
                    <td>${rel.TARGET_TEXT || rel.TARGET_ID}</td>
                  </tr>
                `;
              });
              
              html += `
                    </tbody>
                  </table>
                </div>
              `;
            }
            
            detailsContent.innerHTML = html;
          })
          .catch(error => {
            console.error('Error fetching node details:', error);
            detailsContent.innerHTML = 'Error loading details';
          });
      }
      
      function dragstarted(event) {
        if (!event.active) simulation.alphaTarget(0.3).restart();
        event.subject.fx = event.subject.x;
        event.subject.fy = event.subject.y;
      }
      
      function dragged(event) {
        event.subject.fx = event.x;
        event.subject.fy = event.y;
      }
      
      function dragended(event) {
        if (!event.active) simulation.alphaTarget(0);
        event.subject.fx = null;
        event.subject.fy = null;
      }
      
      function resetZoom() {
        svg.transition()
          .duration(750)
          .call(
            zoom.transform,
            d3.zoomIdentity,
            d3.zoomTransform(svg.node()).invert([width / 2, height / 2])
          );
      }
      
      function toggleDetails() {
        if (detailsPanel.style.display === 'none') {
          detailsPanel.style.display = 'block';
          toggleDetailsButton.textContent = 'Hide Details';
        } else {
          detailsPanel.style.display = 'none';
          toggleDetailsButton.textContent = 'Show Details';
        }
        handleResize();
      }
      
      function handleResize() {
        width = graphContainer.clientWidth;
        height = graphContainer.clientHeight;
        
        svg
          .attr('width', width)
          .attr('height', height);
        
        simulation.force('center', d3.forceCenter(width / 2, height / 2));
        simulation.alpha(0.3).restart();
      }
    });
  </script>
</body>
</html>
