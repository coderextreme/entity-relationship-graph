// server.js
const express = require('express');
const sqlite3 = require('sqlite3').verbose();
const path = require('path');

const app = express();
const port = 3000;

// Serve static files
app.use(express.static(path.join(__dirname, 'public')));

// Database connection
const db = new sqlite3.Database('./EntityRelationship.sqlite3', (err) => {
  if (err) {
    console.error('Error opening database:', err.message);
  } else {
    console.log('Connected to the SQLite database.');
  }
});

// API endpoint to get all nodes (entities)
app.get('/api/nodes', (req, res) => {
  const query = `
    SELECT 
      e.ID, 
      et.NAME as TYPE_NAME, 
      e.INTEGER_VALUE, 
      e.TEXT_VALUE, 
      e.BOOLEAN_VALUE, 
      e.REAL_VALUE, 
      e.SOURCE_FILE
    FROM Entity e
    JOIN EntityType et ON e.TYPE_ID = et.ID
  `;
  
  db.all(query, [], (err, rows) => {
    if (err) {
      res.status(500).json({ error: err.message });
      return;
    }
    
    // Transform the data for visualization
    const nodes = rows.map(row => {
      let label = '';
      
      // Get a readable value based on type
      switch (row.TYPE_NAME) {
        case 'INTEGER':
          label = row.INTEGER_VALUE?.toString() || 'null';
          break;
        case 'TEXT':
          label = row.TEXT_VALUE || 'null';
          break;
        case 'BOOLEAN':
          label = row.BOOLEAN_VALUE ? 'true' : 'false';
          break;
        case 'REAL':
          label = row.REAL_VALUE?.toString() || 'null';
          break;
        case 'OBJECT':
          label = 'Object';
          break;
        case 'ARRAY':
          label = 'Array';
          break;
        default:
          label = 'Unknown';
      }
      
      return {
        id: row.ID,
        label: label.substring(0, 30) + (label.length > 30 ? '...' : ''),
        type: row.TYPE_NAME,
        fullLabel: label,
        sourceFile: row.SOURCE_FILE
      };
    });
    
    res.json(nodes);
  });
});

// API endpoint to get all links (relationships)
app.get('/api/links', (req, res) => {
  const query = `
    SELECT 
      r.ID,
      r.SOURCE_ID, 
      r.PROPERTY_ID, 
      r.TARGET_ID, 
      r.RELATIONSHIP_TYPE
    FROM Relationship r
  `;
  
  db.all(query, [], (err, rows) => {
    if (err) {
      res.status(500).json({ error: err.message });
      return;
    }
    
    const links = rows.map(row => ({
      id: row.ID,
      source: row.SOURCE_ID,
      target: row.TARGET_ID,
      property: row.PROPERTY_ID,
      type: row.RELATIONSHIP_TYPE
    }));
    
    res.json(links);
  });
});

// API endpoint to get a graph filtered by source file
app.get('/api/graph/:sourceFile?', (req, res) => {
  const sourceFile = req.params.sourceFile;
  
  // If no source file is specified, get a limited number of nodes
  let entitiesQuery;
  let params = [];
  
  if (sourceFile) {
    entitiesQuery = `
      SELECT 
        e.ID, 
        et.NAME as TYPE_NAME, 
        e.INTEGER_VALUE, 
        e.TEXT_VALUE, 
        e.BOOLEAN_VALUE, 
        e.REAL_VALUE, 
        e.SOURCE_FILE
      FROM Entity e
      JOIN EntityType et ON e.TYPE_ID = et.ID
      WHERE e.SOURCE_FILE = ?
    `;
    params.push(sourceFile);
  } else {
    entitiesQuery = `
      SELECT 
        e.ID, 
        et.NAME as TYPE_NAME, 
        e.INTEGER_VALUE, 
        e.TEXT_VALUE, 
        e.BOOLEAN_VALUE, 
        e.REAL_VALUE, 
        e.SOURCE_FILE
      FROM Entity e
      JOIN EntityType et ON e.TYPE_ID = et.ID
      LIMIT 500
    `;
  }
  
  db.all(entitiesQuery, params, (err, entityRows) => {
    if (err) {
      res.status(500).json({ error: err.message });
      return;
    }
    
    // Get node IDs to filter relationships
    const nodeIds = entityRows.map(row => row.ID);
    const placeholders = nodeIds.map(() => '?').join(',');
    
    // Get relationships for these entities
    const relationshipsQuery = `
      SELECT 
        r.ID,
        r.SOURCE_ID, 
        r.PROPERTY_ID, 
        r.TARGET_ID, 
        r.RELATIONSHIP_TYPE
      FROM Relationship r
      WHERE r.SOURCE_ID IN (${placeholders})
        AND r.TARGET_ID IN (${placeholders})
    `;
    
    db.all(relationshipsQuery, [...nodeIds, ...nodeIds], (err, relationshipRows) => {
      if (err) {
        res.status(500).json({ error: err.message });
        return;
      }
      
      // Transform entity data for visualization
      const nodes = entityRows.map(row => {
        let label = '';
        
        // Get a readable value based on type
        switch (row.TYPE_NAME) {
          case 'INTEGER':
            label = row.INTEGER_VALUE?.toString() || 'null';
            break;
          case 'TEXT':
            label = row.TEXT_VALUE || 'null';
            break;
          case 'BOOLEAN':
            label = row.BOOLEAN_VALUE ? 'true' : 'false';
            break;
          case 'REAL':
            label = row.REAL_VALUE?.toString() || 'null';
            break;
          case 'OBJECT':
            label = 'Object';
            break;
          case 'ARRAY':
            label = 'Array';
            break;
          default:
            label = 'Unknown';
        }
        
        return {
          id: row.ID,
          label: label.substring(0, 30) + (label.length > 30 ? '...' : ''),
          type: row.TYPE_NAME,
          fullLabel: label,
          sourceFile: row.SOURCE_FILE
        };
      });
      
      // Transform relationship data
      const links = relationshipRows.map(row => ({
        id: row.ID,
        source: row.SOURCE_ID,
        target: row.TARGET_ID,
        property: row.PROPERTY_ID,
        type: row.RELATIONSHIP_TYPE
      }));
      
      // Get all source files for dropdown
      db.all(
        'SELECT DISTINCT SOURCE_FILE FROM Entity WHERE SOURCE_FILE IS NOT NULL',
        [],
        (err, sourceRows) => {
          if (err) {
            res.status(500).json({ error: err.message });
            return;
          }
          
          const sourceFiles = sourceRows.map(row => row.SOURCE_FILE);
          
          res.json({
            nodes,
            links,
            sourceFiles
          });
        }
      );
    });
  });
});

// API endpoint to get details for a specific node
app.get('/api/node/:id', (req, res) => {
  const nodeId = req.params.id;
  
  const query = `
    SELECT 
      e.ID, 
      et.NAME as TYPE_NAME, 
      e.INTEGER_VALUE, 
      e.TEXT_VALUE, 
      e.BOOLEAN_VALUE, 
      e.REAL_VALUE, 
      e.NUMERIC_VALUE,
      e.SOURCE_FILE
    FROM Entity e
    JOIN EntityType et ON e.TYPE_ID = et.ID
    WHERE e.ID = ?
  `;
  
  db.get(query, [nodeId], (err, row) => {
    if (err) {
      res.status(500).json({ error: err.message });
      return;
    }
    
    if (!row) {
      res.status(404).json({ error: 'Node not found' });
      return;
    }
    
    // Get relationships for this node
    const relationshipsQuery = `
      SELECT 
        r.ID,
        r.SOURCE_ID, 
        r.PROPERTY_ID, 
        r.TARGET_ID, 
        r.RELATIONSHIP_TYPE,
        s.TEXT_VALUE as SOURCE_TEXT,
        p.TEXT_VALUE as PROPERTY_TEXT,
        t.TEXT_VALUE as TARGET_TEXT,
        et_s.NAME as SOURCE_TYPE,
        et_p.NAME as PROPERTY_TYPE,
        et_t.NAME as TARGET_TYPE
      FROM Relationship r
      LEFT JOIN Entity s ON r.SOURCE_ID = s.ID
      LEFT JOIN Entity p ON r.PROPERTY_ID = p.ID
      LEFT JOIN Entity t ON r.TARGET_ID = t.ID
      LEFT JOIN EntityType et_s ON s.TYPE_ID = et_s.ID
      LEFT JOIN EntityType et_p ON p.TYPE_ID = et_p.ID
      LEFT JOIN EntityType et_t ON t.TYPE_ID = et_t.ID
      WHERE r.SOURCE_ID = ? OR r.TARGET_ID = ? OR r.PROPERTY_ID = ?
    `;
    
    db.all(relationshipsQuery, [nodeId, nodeId, nodeId], (err, relationshipRows) => {
      if (err) {
        res.status(500).json({ error: err.message });
        return;
      }
      
      // Format node details
      const nodeDetails = {
        id: row.ID,
        type: row.TYPE_NAME,
        value: null,
        sourceFile: row.SOURCE_FILE,
        relationships: relationshipRows
      };
      
      // Set the value based on type
      switch (row.TYPE_NAME) {
        case 'INTEGER':
          nodeDetails.value = row.INTEGER_VALUE;
          break;
        case 'TEXT':
          nodeDetails.value = row.TEXT_VALUE;
          break;
        case 'BOOLEAN':
          nodeDetails.value = !!row.BOOLEAN_VALUE;
          break;
        case 'REAL':
          nodeDetails.value = row.REAL_VALUE;
          break;
        case 'NUMERIC':
          nodeDetails.value = row.NUMERIC_VALUE;
          break;
      }
      
      res.json(nodeDetails);
    });
  });
});

// Start the server
app.listen(port, () => {
  console.log(`Server running at http://localhost:${port}`);
});

// Close the database connection when the server is closed
process.on('SIGINT', () => {
  db.close();
  process.exit(0);
});
